# Copiar como .env y completar. En Render se cargan en "Environment".

# Base local (docker-compose). En Render se usa solo DATABASE_URL (la de Neon).
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=secret123!
DB_NAME=hermanas
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require
PORT=3000

# Login del panel (un solo usuario).
# El hash se genera con:  npm run hash -- "la-contraseña"
ADMIN_USUARIO=hermanas
ADMIN_PASSWORD_HASH=

# Secreto para firmar los tokens: un texto largo y al azar. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=7d

# Fotos de las variedades (Cloudinary, plan gratis). Copiar de Cloudinary → Settings →
# API Keys la "API environment variable": cloudinary://<api_key>:<api_secret>@<cloud_name>
# Sin esta variable la API funciona igual, pero no se pueden subir fotos.
CLOUDINARY_URL=
